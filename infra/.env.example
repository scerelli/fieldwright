# Copy to infra/.env and adjust before running the stack:
#   cp infra/.env.example infra/.env
# Compose reads infra/.env automatically when run from this directory. The
# defaults below are also baked into docker-compose.yml, so the stack starts
# without a .env; set it to change credentials or the published API port.

# PostgreSQL/PostGIS service. These also build the DATABASE_URL the api and
# worker connect with, so user, password and database stay in sync.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ibis

# Host port the API is published on.
API_PORT=3000

# Evidence storage defaults to the `media` volume, so the stack needs no object
# storage. To store Evidence in an S3-compatible service (MinIO or any S3)
# instead, uncomment and set these; the Compose stack passes each to the api and
# worker only when set. MEDIA_S3_ENDPOINT is for MinIO/S3-compatible services;
# omit it for AWS S3. MEDIA_S3_FORCE_PATH_STYLE defaults to true when an
# endpoint is set, and MEDIA_S3_REGION defaults to us-east-1.
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_S3_ENDPOINT=http://minio:9000
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=ibis-evidence
# MEDIA_S3_ACCESS_KEY_ID=minioadmin
# MEDIA_S3_SECRET_ACCESS_KEY=minioadmin
# MEDIA_S3_FORCE_PATH_STYLE=true
# MEDIA_S3_PRESIGN_EXPIRY_SECONDS=900
