{
  "name": "@ibis/protocol",
  "version": "0.0.1",
  "description": "IBIS versioned protocol document — TypeScript types and JSON Schema shared by app/ and server/",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema/protocol.schema.json": "./schema/protocol.schema.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ test/",
    "lint:fix": "oxlint --fix src/ test/",
    "lint:type-aware": "oxlint --type-aware src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "ajv": "8.20.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
