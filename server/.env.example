# PostgreSQL connection string used by the server for Drizzle and the pg pool.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ibis

# Redis connection string used by the server for the BullMQ queue.
REDIS_URL=redis://localhost:6379

# Secret Better Auth uses to sign auth tokens and cookies. Required; use a long
# random value. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret

# Public base URL of this server. Optional; Better Auth infers it from the
# request when unset. Set it behind a reverse proxy.
BETTER_AUTH_URL=http://localhost:3000
